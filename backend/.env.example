# Copy to .env for local (non-Docker) runs. docker-compose injects its own.
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=apppass
DB_HOST=localhost
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
